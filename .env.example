```env
# =========================================================
# Application
# =========================================================

# Frontend application URL
FRONTEND_URL=http://localhost:3000

# Environment: development | production | test
NODE_ENV=development

# Backend server port
PORT=5000


# =========================================================
# Database
# =========================================================

# PostgreSQL connection string
# Format:
# postgresql://USERNAME:PASSWORD@HOST:PORT/DATABASE_NAME
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/health_care_management


# =========================================================
# Better Auth
# =========================================================

# Secret key used by Better Auth for signing/encryption.
# Use a long, random, secure value in the real .env file.
BETTER_AUTH_SECRET=

# Base URL of the backend application
BETTER_AUTH_URL=http://localhost:5000


# =========================================================
# JWT
# =========================================================

# Secret used to sign access tokens
ACCESS_TOKEN_SECRET=

# Secret used to sign refresh tokens
REFRESH_TOKEN_SECRET=

# Access token expiration time
# Examples: 15m, 1h, 1d
ACCESS_TOKEN_EXPIRES_IN=1d

# Refresh token expiration time
# Examples: 7d, 30d
REFRESH_TOKEN_EXPIRES_IN=7d


# =========================================================
# SMTP / Email Configuration
# =========================================================

# SMTP server host
# For Gmail:
SMTP_HOST=smtp.gmail.com

# Gmail SMTP port
# 587 = STARTTLS
SMTP_PORT=587

# SMTP account email address
SMTP_USER=

# SMTP password / Gmail App Password
# Do NOT use your normal Gmail password.
# Generate an App Password from your Google Account.
SMTP_PASS=


# =========================================================
# Google OAuth
# =========================================================

# Google Cloud Console → OAuth 2.0 Client ID
GOOGLE_CLIENT_ID=

# Google OAuth Client Secret
GOOGLE_CLIENT_SECRET=


# =========================================================
# IMPORTANT
# =========================================================

# 1. Never put real secrets in .env.example.
# 2. Put actual values in .env.
# 3. Add .env to .gitignore.
# 4. Share .env.example with other developers.
# 5. Never commit API keys, passwords, JWT secrets,
#    OAuth secrets, or SMTP App Passwords to GitHub.
```
