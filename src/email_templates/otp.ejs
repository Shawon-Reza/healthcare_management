
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Email Verification</title>

    <style>
        @keyframes pulse {
            0% {
                box-shadow: 0 0 0 0 rgba(198, 161, 82, 0.25);
            }

            70% {
                box-shadow: 0 0 0 12px rgba(198, 161, 82, 0);
            }

            100% {
                box-shadow: 0 0 0 0 rgba(198, 161, 82, 0);
            }
        }

        @keyframes shine {
            0% {
                background-position: -200% center;
            }

            100% {
                background-position: 200% center;
            }
        }

        .otp-box {
            animation: pulse 2.5s infinite;
        }

        .otp-code {
            background: linear-gradient(
                90deg,
                #b58a3a,
                #e2c477,
                #b58a3a
            );
            background-size: 200% auto;
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            animation: shine 3s linear infinite;
        }

        @media only screen and (max-width: 600px) {
            .email-wrapper {
                padding: 25px 12px !important;
            }

            .email-card {
                border-radius: 16px !important;
            }

            .email-content {
                padding: 35px 24px !important;
            }

            .heading {
                font-size: 26px !important;
            }

            .otp-code {
                font-size: 34px !important;
                letter-spacing: 7px !important;
            }
        }
    </style>
</head>


<body style="
    margin: 0;
    padding: 0;
    background-color: #f6f4ef;
    font-family: Arial, Helvetica, sans-serif;
    color: #222222;
">

    <!-- Background -->
    <div class="email-wrapper" style="
        width: 100%;
        padding: 55px 20px;
        box-sizing: border-box;
        background-color: #f6f4ef;
    ">

        <!-- Card -->
        <div class="email-card" style="
            max-width: 560px;
            margin: 0 auto;
            background-color: #ffffff;
            border: 1px solid #e8e3d8;
            border-radius: 20px;
            overflow: hidden;
            box-shadow: 0 18px 50px rgba(30, 25, 15, 0.08);
        ">

            <!-- Gold top line -->
            <div style="
                height: 3px;
                background-color: #c6a152;
            "></div>


            <!-- Content -->
            <div class="email-content" style="
                padding: 48px 45px;
            ">

                <!-- Brand -->
                <div style="
                    text-align: center;
                    margin-bottom: 38px;
                ">

                    <span style="
                        display: inline-block;
                        padding: 8px 16px;
                        border: 1px solid #dfd2b5;
                        border-radius: 50px;
                        color: #a47d32;
                        font-size: 11px;
                        font-weight: 700;
                        letter-spacing: 3px;
                        text-transform: uppercase;
                    ">
                        YOUR BRAND
                    </span>

                </div>


                <!-- Icon -->
                <div style="
                    text-align: center;
                    margin-bottom: 22px;
                ">

                    <div style="
                        width: 54px;
                        height: 54px;
                        margin: 0 auto;
                        border-radius: 50%;
                        background-color: #faf7ef;
                        border: 1px solid #e7dcc2;
                        line-height: 54px;
                        font-size: 23px;
                    ">
                        ✦
                    </div>

                </div>


                <!-- Heading -->
                <h1 class="heading" style="
                    margin: 0;
                    text-align: center;
                    font-size: 30px;
                    line-height: 1.3;
                    font-weight: 600;
                    letter-spacing: -0.5px;
                    color: #1d1d1d;
                ">
                    Verify Your Email
                </h1>


                <!-- Description -->
                <p style="
                    max-width: 430px;
                    margin: 14px auto 0;
                    text-align: center;
                    font-size: 15px;
                    line-height: 1.8;
                    color: #77736b;
                ">
                    Hello
                    <strong style="color: #292722;">
                        <%= userName %>
                    </strong>,
                    <br>

                    Thank you for joining us.
                    Use the verification code below to continue.
                </p>


                <!-- OTP Card -->
                <div class="otp-box" style="
                    margin: 35px 0;
                    padding: 30px 20px;
                    text-align: center;
                    background-color: #fcfaf5;
                    border: 1px solid #e8dfca;
                    border-radius: 16px;
                ">

                    <p style="
                        margin: 0 0 12px;
                        font-size: 10px;
                        font-weight: 700;
                        letter-spacing: 3px;
                        text-transform: uppercase;
                        color: #9b968c;
                    ">
                        Verification Code
                    </p>


                    <div class="otp-code" style="
                        font-size: 40px;
                        font-weight: 700;
                        letter-spacing: 11px;
                        padding-left: 11px;
                    ">
                        <%= otp %>
                    </div>

                </div>


                <!-- Expiry -->
                <div style="
                    text-align: center;
                    margin-bottom: 32px;
                ">

                    <p style="
                        margin: 0;
                        font-size: 13px;
                        color: #8c887f;
                        line-height: 1.7;
                    ">
                        This code will expire shortly.
                        <br>
                        For your security, never share this code with anyone.
                    </p>

                </div>


                <!-- Divider -->
                <div style="
                    height: 1px;
                    background-color: #eeeae2;
                    margin: 30px 0;
                "></div>


                <!-- Security Notice -->
                <div style="
                    text-align: center;
                ">

                    <p style="
                        margin: 0;
                        font-size: 12px;
                        line-height: 1.7;
                        color: #a09b91;
                    ">
                        If you didn't request this verification code,
                        you can safely ignore this email.
                    </p>

                </div>


                <!-- Footer -->
                <div style="
                    text-align: center;
                    margin-top: 30px;
                ">

                    <p style="
                        margin: 0;
                        font-size: 12px;
                        color: #b0aca4;
                    ">
                        © 2026 YOUR BRAND
                    </p>

                </div>

            </div>

        </div>

    </div>

</body>

</html>
