
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Password Reset OTP</title>

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            padding: 0;
            background: #f4f7fb;
            font-family: Arial, Helvetica, sans-serif;
            color: #172033;
        }

        .wrapper {
            width: 100%;
            padding: 50px 20px;
            background:
                radial-gradient(circle at 15% 15%, rgba(99, 102, 241, 0.10), transparent 30%),
                radial-gradient(circle at 85% 85%, rgba(14, 165, 233, 0.10), transparent 30%),
                #f4f7fb;
        }

        .container {
            width: 100%;
            max-width: 620px;
            margin: 0 auto;
            background: #ffffff;
            border-radius: 24px;
            overflow: hidden;
            border: 1px solid #e7ebf2;
            box-shadow:
                0 25px 70px rgba(23, 32, 51, 0.10),
                0 8px 25px rgba(23, 32, 51, 0.05);
        }

        /* Top decorative area */
        .hero {
            position: relative;
            padding: 38px 35px 32px;
            text-align: center;
            background: linear-gradient(
                135deg,
                #f8faff 0%,
                #eef4ff 50%,
                #f7fbff 100%
            );
            overflow: hidden;
        }

        .hero::before,
        .hero::after {
            content: "";
            position: absolute;
            border-radius: 50%;
            filter: blur(2px);
            opacity: 0.5;
            animation: float 6s ease-in-out infinite;
        }

        .hero::before {
            width: 150px;
            height: 150px;
            background: rgba(99, 102, 241, 0.12);
            top: -75px;
            left: -55px;
        }

        .hero::after {
            width: 130px;
            height: 130px;
            background: rgba(14, 165, 233, 0.12);
            right: -50px;
            bottom: -65px;
            animation-delay: -3s;
        }

        .lock {
            position: relative;
            z-index: 2;
            width: 68px;
            height: 68px;
            margin: 0 auto 20px;
            border-radius: 20px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: #ffffff;
            border: 1px solid #e4e9f2;
            box-shadow: 0 12px 30px rgba(79, 70, 229, 0.14);
            font-size: 30px;
            animation: pulse 2.8s ease-in-out infinite;
        }

        .hero h1 {
            position: relative;
            z-index: 2;
            margin: 0;
            font-size: 28px;
            line-height: 1.25;
            color: #111827;
            letter-spacing: -0.5px;
        }

        .hero p {
            position: relative;
            z-index: 2;
            margin: 10px auto 0;
            max-width: 440px;
            font-size: 14px;
            line-height: 1.7;
            color: #64748b;
        }

        .content {
            padding: 38px 42px 42px;
        }

        .greeting {
            margin: 0 0 10px;
            font-size: 16px;
            color: #334155;
        }

        .description {
            margin: 0 0 28px;
            font-size: 14px;
            line-height: 1.8;
            color: #64748b;
        }

        /* OTP Card */
        .otp-card {
            position: relative;
            margin: 30px 0;
            padding: 28px 20px;
            text-align: center;
            border-radius: 18px;
            background: linear-gradient(135deg, #f8faff, #f1f5ff);
            border: 1px solid #dfe6f5;
            overflow: hidden;
        }

        .otp-card::before {
            content: "";
            position: absolute;
            top: 0;
            left: -100%;
            width: 70%;
            height: 100%;
            background: linear-gradient(
                90deg,
                transparent,
                rgba(255, 255, 255, 0.75),
                transparent
            );
            animation: shine 3.5s ease-in-out infinite;
        }

        .otp-label {
            position: relative;
            z-index: 1;
            margin-bottom: 13px;
            font-size: 11px;
            font-weight: 700;
            letter-spacing: 2px;
            text-transform: uppercase;
            color: #64748b;
        }

        .otp {
            position: relative;
            z-index: 1;
            display: inline-block;
            font-size: 36px;
            font-weight: 800;
            letter-spacing: 9px;
            color: #4338ca;
            padding-left: 9px;
        }

        .expiry {
            position: relative;
            z-index: 1;
            margin-top: 12px;
            font-size: 12px;
            color: #94a3b8;
        }

        .security {
            display: flex;
            align-items: flex-start;
            gap: 13px;
            padding: 17px;
            margin-top: 28px;
            border-radius: 14px;
            background: #fffaf0;
            border: 1px solid #f6e7c1;
        }

        .security-icon {
            flex-shrink: 0;
            font-size: 18px;
        }

        .security p {
            margin: 0;
            font-size: 12px;
            line-height: 1.7;
            color: #7c6840;
        }

        .security strong {
            color: #5f4b20;
        }

        .footer {
            padding: 25px 35px;
            text-align: center;
            background: #f8fafc;
            border-top: 1px solid #edf0f5;
        }

        .footer-brand {
            margin-bottom: 8px;
            font-size: 13px;
            font-weight: 700;
            color: #334155;
        }

        .footer-text {
            margin: 0;
            font-size: 11px;
            line-height: 1.6;
            color: #94a3b8;
        }

        .footer-link {
            color: #6366f1;
            text-decoration: none;
        }

        @keyframes float {
            0%, 100% {
                transform: translate(0, 0);
            }

            50% {
                transform: translate(15px, 12px);
            }
        }

        @keyframes pulse {
            0%, 100% {
                transform: scale(1);
                box-shadow: 0 12px 30px rgba(79, 70, 229, 0.14);
            }

            50% {
                transform: scale(1.04);
                box-shadow: 0 15px 38px rgba(79, 70, 229, 0.22);
            }
        }

        @keyframes shine {
            0% {
                left: -100%;
            }

            45%, 100% {
                left: 130%;
            }
        }

        @media only screen and (max-width: 600px) {
            .wrapper {
                padding: 25px 12px;
            }

            .hero {
                padding: 32px 20px 28px;
            }

            .content {
                padding: 30px 22px 32px;
            }

            .hero h1 {
                font-size: 24px;
            }

            .otp {
                font-size: 30px;
                letter-spacing: 7px;
            }

            .footer {
                padding: 22px 20px;
            }
        }
    </style>
</head>

<body>

    <div class="wrapper">

        <div class="container">

            <!-- Hero -->
            <div class="hero">

                <div class="lock">
                    🔐
                </div>

                <h1>Password Reset Request</h1>

                <p>
                    We received a request to reset the password for your account.
                </p>

            </div>

            <!-- Main Content -->
            <div class="content">

                <p class="greeting">
                    Hello <strong><%= userName || "there" %></strong>,
                </p>

                <p class="description">
                    Use the one-time password below to continue resetting your
                    password. For your security, this code can only be used for
                    a limited time.
                </p>

                <!-- OTP -->
                <div class="otp-card">

                    <div class="otp-label">
                        Your verification code
                    </div>

                    <div class="otp">
                        <%= otp %>
                    </div>

                    <div class="expiry">
                        This OTP expires in 5 minutes
                    </div>

                </div>

                <!-- Security Notice -->
                <div class="security">

                    <div class="security-icon">
                        🛡️
                    </div>

                    <p>
                        <strong>Security notice:</strong>
                        Never share this OTP with anyone.
                        Our team will never ask you for this verification code.
                        If you didn't request a password reset, you can safely
                        ignore this email.
                    </p>

                </div>

            </div>

            <!-- Footer -->
            <div class="footer">

                <div class="footer-brand">
                    Your Application
                </div>

                <p class="footer-text">
                    This is an automated security email. Please do not reply
                    directly to this message.
                    <br>
                    © <%= new Date().getFullYear() %> Your Application. All rights reserved.
                </p>

            </div>

        </div>

    </div>

</body>
</html>

